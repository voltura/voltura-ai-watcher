<Window x:Class="VolturaAiWatcher.MessageDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Complete Codex message"
        Width="640"
        Height="520"
        MinWidth="430"
        MinHeight="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        FontFamily="Bahnschrift SemiCondensed"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="#F21A2A1E" />
            <Setter Property="Foreground" Value="#7CFF9A" />
            <Setter Property="BorderBrush" Value="#6B4BFF7A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Placement" Value="Top" />
            <Setter Property="VerticalOffset" Value="-6" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="60" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DetailButton" TargetType="Button">
            <Setter Property="Foreground" Value="#7CFF9A" />
            <Setter Property="Background" Value="#FF0B1710" />
            <Setter Property="BorderBrush" Value="#6254B96B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="60" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="500" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#FF112419" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#B07CFF9A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DetailFileButton"
               TargetType="Button"
               BasedOn="{StaticResource DetailButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style x:Key="DetailFileIcon" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="#7CFF9A" />
            <Setter Property="StrokeThickness" Value="1.25" />
            <Setter Property="StrokeStartLineCap" Value="Square" />
            <Setter Property="StrokeEndLineCap" Value="Square" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>
        <Style x:Key="DetailHeaderActionButton" TargetType="Button">
            <Setter Property="ToolTipService.InitialShowDelay" Value="60" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="#B008110B" />
            <Setter Property="BorderBrush" Value="#485EBB70" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#E0142017" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#B07CFF9A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DetailHeaderActionIcon" TargetType="Path">
            <Setter Property="Stroke" Value="#7CFF9A" />
            <Setter Property="StrokeThickness" Value="1.45" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
        </Style>
        <Style x:Key="DetailThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Margin="2"
                                Background="#A05CD77A"
                                BorderBrush="#B07CFF9A"
                                BorderThickness="1"
                                CornerRadius="4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="11" />
            <Setter Property="Background" Value="#FF07100B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#3154B96B"
                                BorderThickness="1,0,0,0">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DetailThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FF070C09"
            BorderBrush="#B05CD77A"
            BorderThickness="1"
            CornerRadius="11"
            Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="8"
                         Height="8"
                         Fill="{Binding StatusBrush}"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0" />
                <TextBlock Grid.Column="1"
                           Text="{Binding DetailHeading}"
                           Foreground="#7CFF9A"
                           FontWeight="Bold"
                           FontSize="13" />
                <TextBlock Grid.Column="2"
                           Text="{Binding StatusSummary}"
                           Foreground="{Binding StatusBrush}"
                           FontSize="9"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <Button Grid.Column="3"
                        Style="{StaticResource DetailHeaderActionButton}"
                        ToolTip="Close message"
                        Click="Close_Click">
                    <Path Data="M3,3 L13,13 M13,3 L3,13"
                          Style="{StaticResource DetailHeaderActionIcon}" />
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,14,0,10">
                <StackPanel Orientation="Horizontal" ToolTip="{Binding ProjectToolTip}">
                    <Path Data="{Binding ProjectIconGeometry}"
                          Fill="{Binding ProjectColorBrush}"
                          Width="14"
                          Height="14"
                          Stretch="Uniform"
                          Margin="0,0,6,0">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasProjectIcon}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <TextBlock Text="{Binding HeaderText}"
                               Foreground="{Binding ProjectColorBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Border Margin="0,6,0,0"
                        Padding="7,3"
                        HorizontalAlignment="Left"
                        Background="#B00D1C13"
                        BorderBrush="#4854B96B"
                        BorderThickness="1"
                        CornerRadius="5"
                        ToolTip="{Binding DetailUsageToolTip}">
                    <TextBlock Text="{Binding DetailUsageText}"
                               Foreground="#74D98A"
                               FontSize="9"
                               FontWeight="SemiBold" />
                </Border>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding LocalTimeText}"
                               Foreground="#587A61"
                               FontSize="8"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="1"
                            Margin="12,0,6,0"
                            Padding="7,3"
                            Background="#B00D1C13"
                            BorderBrush="#6254B96B"
                            BorderThickness="1"
                            CornerRadius="5"
                            ToolTip="{Binding GitToolTip}">
                        <TextBlock Text="{Binding GitHeaderText}"
                                   Foreground="#7CFF9A"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Button Grid.Column="2"
                            Style="{StaticResource DetailHeaderActionButton}"
                            IsEnabled="{Binding CanRefreshGit}"
                            ToolTip="Refresh repository status"
                            Click="RefreshGit_Click">
                        <Path Data="M12.5,5 A5,5 0 1 0 13,10 M12.5,2 V5 H9.5"
                              Style="{StaticResource DetailHeaderActionIcon}" />
                    </Button>
                    <Button Grid.Column="3"
                            Style="{StaticResource DetailHeaderActionButton}"
                            Width="48"
                            Margin="5,0,0,0"
                            IsEnabled="{Binding CanCommitAndPush}"
                            Content="PUSH"
                            Foreground="#7CFF9A"
                            FontSize="9"
                            FontWeight="Bold"
                            ToolTip="Review, commit, and push all repository changes"
                            Click="CommitPush_Click" />
                </Grid>
            </StackPanel>

            <Border Grid.Row="2"
                    Background="#FF0B1710"
                    BorderBrush="#6254B96B"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="12">
                <FlowDocumentScrollViewer x:Name="MessageBodyViewer"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsToolBarVisible="False"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" />
            </Border>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PreviousButton"
                            Style="{StaticResource DetailButton}"
                            Margin="0"
                            Content="← PREVIOUS"
                            ToolTip="Show the previous, older visible message"
                            Click="Previous_Click" />
                    <Button x:Name="NextButton"
                            Style="{StaticResource DetailButton}"
                            Content="NEXT →"
                            ToolTip="Show the next, newer visible message"
                            Click="Next_Click" />
                    <Button Style="{StaticResource DetailFileButton}"
                            IsEnabled="{Binding IsReferencedFileAvailable}"
                            Visibility="{Binding IsReferencedFileAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{Binding ReferencedFileOpenToolTip}"
                            Click="OpenReferencedFile_Click">
                        <Path Data="M4,3 H9 L11,5 H14 V14 H4 Z M7,9 H12 M10,6 L13,9 L10,12"
                              Style="{StaticResource DetailFileIcon}" />
                    </Button>
                    <Button Style="{StaticResource DetailFileButton}"
                            IsEnabled="{Binding IsReferencedFileAvailable}"
                            Visibility="{Binding IsReferencedFileAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="Copy file"
                            Click="CopyReferencedFile_Click">
                        <Path Data="M6,3 H15 V12 H6 Z M3,6 H5 V14 H12 V13"
                              Style="{StaticResource DetailFileIcon}" />
                    </Button>
                    <Button Style="{StaticResource DetailFileButton}"
                            IsEnabled="{Binding IsReferencedFileAvailable}"
                            Visibility="{Binding IsReferencedFileAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="Copy as Path"
                            Click="CopyReferencedFilePath_Click">
                        <Path Data="M4,3 H12 V5 H14 V15 H6 V13 H4 Z M7,7 H11 M7,10 H11 M2,6 H5 V12 H2 Z"
                              Style="{StaticResource DetailFileIcon}" />
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="1"
                            Margin="0,6,0,0"
                            Orientation="Horizontal">
                    <Button Style="{StaticResource DetailButton}"
                            Content="COPY FORMATTED"
                            ToolTip="Copy the readable message shown above"
                            Click="CopyFormatted_Click" />
                    <Button Style="{StaticResource DetailButton}"
                            Content="COPY"
                            ToolTip="Copy the original message"
                            Click="Copy_Click" />
                    <Button Style="{StaticResource DetailButton}"
                            Content="REVIEW"
                            IsEnabled="{Binding CanLaunchReview}"
                            ToolTip="Launch an Review uncommitted changes action."
                            Click="ReviewChanges_Click" />
                    <Button Style="{StaticResource DetailButton}"
                            Content="OPEN IN CODEX"
                            Click="OpenCodex_Click" />
                    <Button Style="{StaticResource DetailButton}"
                            Content="CLOSE"
                            ToolTip="Close message"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
