<Window x:Class="VolturaAiWatcher.MessageDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Complete Codex message"
        Width="640"
        Height="520"
        MinWidth="430"
        MinHeight="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        FontFamily="Bahnschrift SemiCondensed"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <Style x:Key="DetailButton" TargetType="Button">
            <Setter Property="Foreground" Value="#7CFF9A" />
            <Setter Property="Background" Value="#FF0B1710" />
            <Setter Property="BorderBrush" Value="#6254B96B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#FF112419" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#B07CFF9A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DetailThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Margin="2"
                                Background="#A05CD77A"
                                BorderBrush="#B07CFF9A"
                                BorderThickness="1"
                                CornerRadius="4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="11" />
            <Setter Property="Background" Value="#FF07100B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#3154B96B"
                                BorderThickness="1,0,0,0">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DetailThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FF070C09"
            BorderBrush="#B05CD77A"
            BorderThickness="1"
            CornerRadius="11"
            Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="8"
                         Height="8"
                         Fill="{Binding StatusBrush}"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0" />
                <TextBlock Grid.Column="1"
                           Text="COMPLETE CODEX MESSAGE"
                           Foreground="#7CFF9A"
                           FontWeight="Bold"
                           FontSize="13" />
                <TextBlock Grid.Column="2"
                           Text="{Binding StatusSummary}"
                           Foreground="{Binding StatusBrush}"
                           FontSize="9"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,14,0,10">
                <TextBlock Text="{Binding HeaderText}"
                           Foreground="#74D98A"
                           FontSize="10"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding LocalTimeText}"
                           Foreground="#587A61"
                           FontSize="8"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Row="2"
                    Background="#FF0B1710"
                    BorderBrush="#6254B96B"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <TextBlock Text="{Binding Text}"
                               Foreground="#D2F4DA"
                               FontSize="13"
                               LineHeight="19"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="PreviousButton"
                            Style="{StaticResource DetailButton}"
                            Margin="0"
                            Content="← PREVIOUS"
                            ToolTip="Show the previous, older visible message"
                            Click="Previous_Click" />
                    <Button x:Name="NextButton"
                            Style="{StaticResource DetailButton}"
                            Content="NEXT →"
                            ToolTip="Show the next, newer visible message"
                            Click="Next_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource DetailButton}"
                            Content="COPY MESSAGE"
                            Click="Copy_Click" />
                    <Button Style="{StaticResource DetailButton}"
                            Content="OPEN IN CODEX"
                            Click="OpenCodex_Click" />
                    <Button Style="{StaticResource DetailButton}"
                            Content="CLOSE"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
