<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\voltura-ai-watcher.ico</ApplicationIcon>
    <AssemblyName>Voltura AI Watcher</AssemblyName>
    <Version>0.1.4</Version>
    <AssemblyTitle>Voltura AI Watcher</AssemblyTitle>
    <Product>Voltura AI Watcher</Product>
    <Company>Voltura AB</Company>
    <Authors>Joakim Skoglund</Authors>
    <Copyright>Copyright (c) Voltura AB</Copyright>
    <Description>Minimal cyberpunk Codex activity watcher.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\voltura-ai-watcher.ico" />
    <Content Include="Assets\electric-spark.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VolturaAiWatcher.Tests" />
  </ItemGroup>

</Project>
