<Window x:Class="VolturaAiWatcher.CodexNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VolturaAiWatcher"
        Title="Codex activity"
        Width="350"
        Height="154"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Bahnschrift SemiCondensed"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="#F21A2A1E" />
            <Setter Property="Foreground" Value="#7CFF9A" />
            <Setter Property="BorderBrush" Value="#6B4BFF7A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Placement" Value="Top" />
            <Setter Property="VerticalOffset" Value="-6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderActionButton" TargetType="Button">
            <Setter Property="ToolTipService.InitialShowDelay" Value="60" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="#B008110B" />
            <Setter Property="BorderBrush" Value="#485EBB70" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Opacity="{TemplateBinding Opacity}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#E0142017" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#B07CFF9A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.24" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderActionIcon" TargetType="Path">
            <Setter Property="Stroke" Value="#7CFF9A" />
            <Setter Property="StrokeThickness" Value="1.45" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="60" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="#FF0A0F0C" />
            <Setter Property="BorderBrush" Value="#704BFF7A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemShell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Icon" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuItemShell" Property="Background" Value="#FF102619" />
                                <Setter TargetName="MenuItemShell" Property="BorderBrush" Value="#A8FFB9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MenuItemShell" Property="Opacity" Value="0.34" />
                                <Setter TargetName="MenuItemShell" Property="BorderBrush" Value="#403B804B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ContextActionIcon" TargetType="Path">
            <Setter Property="Stroke" Value="#A8FFB9" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
        </Style>
    </Window.Resources>
    <Border x:Name="PanelShell"
            Background="#FA070C09"
            BorderBrush="#B05CD77A"
            BorderThickness="1"
            CornerRadius="10"
            Padding="11">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="7"
                             Height="7"
                             Fill="{Binding StatusBrush}"
                             Margin="0,0,7,0"
                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusSummary}"
                               Foreground="{Binding StatusBrush}"
                               FontSize="8"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource HeaderActionButton}"
                            IsEnabled="{Binding IsReferencedFileAvailable}"
                            Click="OpenReferencedFile_Click"
                            ToolTip="{Binding ReferencedFileOpenToolTip}">
                        <Path Data="M4,3 H9 L11,5 H14 V14 H4 Z M7,9 H12 M10,6 L13,9 L10,12"
                              Style="{StaticResource HeaderActionIcon}" />
                    </Button>
                    <Button Style="{StaticResource HeaderActionButton}"
                            IsEnabled="{Binding IsReferencedFileAvailable}"
                            Click="CopyReferencedFilePath_Click"
                            ToolTip="Copy referenced file path">
                        <Path Data="M4,3 H12 V5 H14 V15 H6 V13 H4 Z M7,7 H11 M7,10 H11 M2,6 H5 V12 H2 Z"
                              Style="{StaticResource HeaderActionIcon}" />
                    </Button>
                    <Button Style="{StaticResource HeaderActionButton}"
                            Click="Dismiss_Click"
                            ToolTip="Dismiss">
                        <Path Data="M3,3 L13,13 M13,3 L3,13"
                              Style="{StaticResource HeaderActionIcon}" />
                    </Button>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1"
                    Margin="0,9,0,0"
                    Padding="9,8"
                    CornerRadius="7"
                    Background="#B009110C"
                    BorderBrush="#4D54B96B"
                    BorderThickness="1"
                    ToolTip="{Binding UsageToolTip}"
                    Cursor="Hand"
                    PreviewMouseLeftButtonUp="Message_Click">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Click="ShowMessageDetails_Click"
                                  ToolTip="Show message details">
                            <MenuItem.Icon>
                                <Path Data="M3,3 H13 V13 H3 Z M5,6 H11 M5,9 H10"
                                      Style="{StaticResource ContextActionIcon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Click="OpenMessageInCodex_Click"
                                  ToolTip="Open in Codex">
                            <MenuItem.Icon>
                                <Path Data="M3,8 L8,3 H14 V14 H3 Z M8,3 V8 H14 M6,11 H11"
                                      Style="{StaticResource ContextActionIcon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Click="OpenReferencedFile_Click"
                                  IsEnabled="{Binding IsReferencedFileAvailable}"
                                  Visibility="{Binding IsReferencedFileAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  ToolTip="{Binding ReferencedFileOpenToolTip}">
                            <MenuItem.Icon>
                                <Path Data="M4,3 H9 L11,5 H14 V14 H4 Z M7,9 H12 M10,6 L13,9 L10,12"
                                      Style="{StaticResource ContextActionIcon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Click="CopyReferencedFilePath_Click"
                                  IsEnabled="{Binding IsReferencedFileAvailable}"
                                  Visibility="{Binding IsReferencedFileAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  ToolTip="Copy referenced file path">
                            <MenuItem.Icon>
                                <Path Data="M4,3 H12 V5 H14 V15 H6 V13 H4 Z M7,7 H11 M7,10 H11 M2,6 H5 V12 H2 Z"
                                      Style="{StaticResource ContextActionIcon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding ProjectToolTip}">
                            <Path Data="{Binding ProjectIconGeometry}"
                                  Fill="{Binding ProjectIconFillBrush}"
                                  Stroke="{Binding ProjectIconStrokeBrush}"
                                  StrokeThickness="{Binding ProjectIconStrokeThickness}"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Margin="0,-2,5,0">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasProjectIcon}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="{Binding HeaderText}"
                                       Foreground="{Binding ProjectColorBrush}"
                                       FontSize="8.5"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding WeeklyUsageText}"
                                   Foreground="#7CFF9A"
                                   FontSize="7"
                                   Margin="8,0,0,0"
                                   MaxWidth="125"
                                   TextAlignment="Right"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding WeeklyUsageToolTip}" />
                    </Grid>
                    <local:CompactMessagePreview Grid.Row="1"
                                                 MessageText="{Binding PreviewText}"
                                                 WorkingDirectory="{Binding WorkingDirectory}"
                                                 Foreground="#D2F4DA"
                                                 FontSize="11"
                                                 Margin="0,6,0,0"
                                                 TextWrapping="Wrap"
                                                 MaxHeight="43"
                                                 TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="2"
                               Text="{Binding LocalTimeText}"
                               Foreground="#587A61"
                               FontSize="7.5"
                               Margin="0,5,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
