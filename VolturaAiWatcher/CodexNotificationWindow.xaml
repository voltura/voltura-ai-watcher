<Window x:Class="VolturaAiWatcher.CodexNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex activity"
        Width="350"
        Height="154"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Bahnschrift SemiCondensed"
        Closing="Window_Closing">
    <Border x:Name="PanelShell"
            Background="#FA070C09"
            BorderBrush="#B05CD77A"
            BorderThickness="1"
            CornerRadius="10"
            Padding="11">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" Margin="0,1,7,0" />
                    <TextBlock Text="{Binding StatusSummary}"
                               Foreground="{Binding StatusBrush}"
                               FontSize="8"
                               FontWeight="Bold" />
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        Width="22"
                        Height="20"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#8AAF92"
                        Cursor="Hand"
                        Click="Dismiss_Click">
                    <Path Data="M3,3 L13,13 M13,3 L3,13"
                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                          StrokeThickness="1.4"
                          Stretch="Uniform"
                          Width="11"
                          Height="11" />
                </Button>
            </Grid>
            <Border Grid.Row="1"
                    Margin="0,9,0,0"
                    Padding="9,8"
                    CornerRadius="7"
                    Background="#B009110C"
                    BorderBrush="#4D54B96B"
                    BorderThickness="1"
                    Cursor="Hand"
                    PreviewMouseLeftButtonUp="Message_Click">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding HeaderText}"
                               Foreground="#74D98A"
                               FontSize="8.5"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1"
                               Text="{Binding Text}"
                               Foreground="#D2F4DA"
                               FontSize="11"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               MaxHeight="43"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="2"
                               Text="{Binding LocalTimeText}"
                               Foreground="#587A61"
                               FontSize="7.5"
                               Margin="0,5,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
